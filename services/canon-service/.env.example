# For JWT verification (app/auth.py) -- required for /me and every
# /knowledge-core/* route. Verified against Supabase's public JWKS, so this
# is the only Supabase config canon-service needs to authenticate a caller.
SUPABASE_URL=https://dghkxaclaeluheahdsne.supabase.co

# For everything /knowledge-core/* actually reads or writes (app/db.py,
# app/repositories.py). This must be a *direct Postgres* connection string
# to the Supabase project's database using its service_role credentials --
# NOT the anon key, and NOT the same value as NEXT_PUBLIC_SUPABASE_URL in
# apps/web/.env.example. Get it from the Supabase dashboard's
# Project Settings -> Database -> Connection string. Never commit the real
# value; never let this reach apps/web.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dghkxaclaeluheahdsne.supabase.co:5432/postgres

# Only used by tests/test_repositories_integration.py and
# tests/test_routes_knowledge_core.py -- point this at a disposable local
# Postgres that already has supabase/testing/local_auth_stub.sql and every
# file in supabase/migrations/ applied (see CLAUDE.md's "Local dev"
# section). Leave unset to skip these tests entirely; the base `pytest`
# suite never needs it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cian_canon_test
